# The OpenAI key the extraction route reads on the server. Copy this file to
# .env.local and put your own key in it. Nothing in the client bundle reads it,
# and .gitignore keeps every .env file but this one out of git.
OPENAI_API_KEY=sk-your-openai-key-here

# The Upstash Redis credentials the per-IP rate limiter reads on the server. The
# Vercel Upstash integration writes both into the project, and they are the only
# two of the five it sets that this app uses. With neither set the limiter counts
# nothing and logs that it is unconfigured, so a local run needs no store.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token-here
