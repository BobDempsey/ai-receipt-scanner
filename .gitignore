# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local browser-driven checks. Nothing here belongs in the repo.
.playwright-mcp/

# tesseract.js assets. The worker script and the wasm cores are copied out of
# node_modules by scripts/copy-tesseract-assets.mjs on every predev and prebuild,
# so no binary from a package enters git and the copy cannot drift from the
# installed version. The language data beside them is committed, because it comes
# from the tessdata_fast release rather than from a package.
/public/tesseract/*
!/public/tesseract/eng.traineddata.gz

# pdf.js worker. scripts/copy-pdfjs-assets.mjs copies it out of node_modules on
# every predev and prebuild, for the same reason the tesseract assets above are
# copied rather than committed.
/public/pdfjs/*
